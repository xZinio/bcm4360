+		if (err == -EBUSY || wl_bcmerr_is_transient(bcmerr)) {
+			WL_INF(("firmware busy (bcmerror %d): scan for \"%s\" deferred\n",
+				bcmerr, sr->ssid.SSID));
+			err = -EBUSY;
 		} else {
-			WL_ERR(("WLC_SCAN error (%d)\n", err));
+			WL_ERR(("WLC_SCAN error (%d, bcmerror %d)\n", err, bcmerr));
 		}
 		goto scan_out;
 	}
