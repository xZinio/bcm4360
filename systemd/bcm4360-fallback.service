# Installed by the bcm4360 driver (scripts/install.sh).
# See /usr/local/lib/bcm4360/bcm4360-fallback.
[Unit]
Description=Load another driver for the BCM4360 if its own is not built for this kernel
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/bcm4360/bcm4360-fallback

[Install]
WantedBy=multi-user.target
