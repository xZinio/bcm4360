# Installed by the bcm4360 driver (scripts/install.sh).
# See /usr/local/lib/bcm4360/bcm4360-watchdog.
[Unit]
Description=Recover bcm4360 Wi-Fi that keeps failing
After=NetworkManager.service

[Service]
ExecStart=/usr/local/lib/bcm4360/bcm4360-watchdog --loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
