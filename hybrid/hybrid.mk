#
# The HYBRID build: layers of Broadcom's object replaced by the open code.
# Included by the Kbuild part of the top-level Makefile when HYBRID is set,
# e.g.  make HYBRID="access pmu mac"   (see hybrid/README.md).
#
# For each layer: the bridge hybrid/<layer>.c, the open files it needs, and
# two symbol lists generated by tools/re/hybrid.py (symbols --write):
#   <layer>.weaken     functions of the object the bridge defines
#   <layer>.globalize  functions of the object the bridge calls
# A copy of the object is made in which those names are global (they are
# local in Broadcom's object) and the bridge's ones weak; the linker then
# resolves every call of the object to such a function to the bridge.

hybrid-known := access pmu mac utils
hybrid-layers := $(sort $(subst $(comma),$(space),$(HYBRID)))
hybrid-bad := $(filter-out $(hybrid-known),$(hybrid-layers))
ifneq ($(hybrid-bad),)
$(error HYBRID: unknown layer(s) $(hybrid-bad); known: $(hybrid-known))
endif

hybrid-open-access := open/hw/access.o
hybrid-open-pmu    := open/chip/pmu.o
hybrid-open-mac    := open/mac/bmac_ctrl.o open/mac/bmac_mhf.o open/hw/access.o
hybrid-open-utils  := open/lib/utils.o

hybrid-objs := $(sort $(foreach l,$(hybrid-layers),hybrid/$(l).o $(hybrid-open-$(l))))

hybrid-weaken    := $(foreach l,$(hybrid-layers),$(src)/hybrid/$(l).weaken)
hybrid-globalize := $(foreach l,$(hybrid-layers),$(src)/hybrid/$(l).globalize)

quiet_cmd_hybrid_blob = OBJCOPY $@ (HYBRID: $(hybrid-layers))
      cmd_hybrid_blob = \
	cat $(hybrid-weaken) $(hybrid-globalize) | grep -v '^\#' | sort -u > $@.global && \
	cat $(hybrid-weaken) | grep -v '^\#' | sort -u > $@.weak && \
	$(OBJCOPY) --globalize-symbols=$@.global $< $@.tmp && \
	$(OBJCOPY) --weaken-symbols=$@.weak $@.tmp $@ && \
	rm -f $@.tmp $@.global $@.weak

$(obj)/wlc_hybrid_open.o: $(src)/lib/wlc_hybrid.o_shipped $(hybrid-weaken) $(hybrid-globalize) FORCE
	$(call if_changed,hybrid_blob)

targets += wlc_hybrid_open.o
