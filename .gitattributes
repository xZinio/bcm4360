# Files read by sh/make on the build machine must keep LF line endings even
# in a checkout on Windows (core.autocrlf).
*.sh            text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
dkms.conf       text eol=lf
hybrid/*.txt    text eol=lf
dkms-open.conf  text eol=lf
systemd/*       text eol=lf
tests/*.sh      text eol=lf
